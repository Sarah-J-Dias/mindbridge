# Copy this file to .env and optionally fill in an Anthropic API key.
# .env is ignored by Git — never paste a real key into any other file.
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-haiku-5-5
MINDBRIDGE_PRELOAD_EMBEDDINGS=false # Toggles preload state for MindBridge embeddings. Set to true to preload embeddings on startup, false to load them on demand.
